# Copy to .env. The default matches docker-compose.yml, so `docker compose up -d`
# then `npx prisma migrate dev` works with no edits.
DATABASE_URL="postgresql://ralla:ralla_dev_only@localhost:5432/ralla?schema=public"

# Signs the session cookie. Generate your own:
#   openssl rand -base64 32
# The signing key mixes this WITH both credentials below, so changing any one of
# the three signs everyone out.
SESSION_SECRET="generate-your-own-do-not-use-this-value"

# The shared staff login for /login. There are no per-user accounts yet —
# everyone signs in with this one pair, so it says nothing about *who* is
# signed in. Change both before deploying anywhere reachable.
# The username is matched case-insensitively and ignores surrounding spaces.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ralla_dev_only"

# Google AI (Gemini) API key for the admin assistant sheet (Haikuu — customer/order/stock lookups).
GEMINI_API_KEY=""
