# Copy to .env. The default matches docker-compose.yml, so `docker compose up -d`
# then `npx prisma migrate dev` works with no edits.
DATABASE_URL="postgresql://ralla:ralla_dev_only@localhost:5554/ralla?schema=public"

# Signs the session cookie. Generate your own:
#   openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET="generate-your-own-do-not-use-this-value"

# Sign-in accounts live in the `staff` table, not here. After `npm run db:migrate`,
# make the first admin with:
#   npm run admin:create
# (it refuses to run once an admin exists; everyone else is added in the app)

# Google AI (Gemini) API key for the admin assistant sheet (Haikuu — customer/order/stock lookups).
GEMINI_API_KEY=""
