// RALLA — order and delivery admin.
//
// Conventions used throughout:
//   * `id` is an internal surrogate key and is never displayed. `code` is the
//     human-facing identifier (RL-10429, RLC-1001) and comes from a Postgres
//     sequence, so two staff saving at once can't mint the same one.
//   * `slug` is what detail URLs carry: random, so a URL can't be guessed from
//     a code (customer codes are a plain sequence). Filled by the database
//     default, which also backfilled every row that existed before it.
//   * Money is a whole number of kyats. Never a float — see CLAUDE.md.
//   * Orders COPY the customer's details at save time instead of joining live.
//     A customer who moves house must not rewrite where past orders were
//     delivered.
//   * Timestamps are `timestamptz`. Myanmar is UTC+06:30, so formatting must
//     happen in Asia/Yangon at render time, never by slicing an ISO string.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Delivery lifecycle. Mirrors DELIVERY_STATUS in lib/orders.ts, which supplies
/// the labels and colors for these values.
enum DeliveryStatus {
  pending
  packing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  paid
  cod
  refunded
}

/// What a signed-in person may do. Only the label is stored here; what each
/// role is allowed to do is decided in code (see lib/permissions.ts).
enum StaffRole {
  staff
  admin
}

/// Kinds of entry in an order's change log (OrderChange).
enum OrderChangeAction {
  created
  updated
  status
  note
  deleted
  restored
}

/// Someone who buys from the shop.
///
/// `id` is the identity and the only thing other records point at. Staff find
/// a customer by `code`, phone or name — see searchCustomers().
model Customer {
  id   Int    @id @default(autoincrement())
  code String @unique @default(dbgenerated("('RLC-' || nextval('customer_code_seq'))"))
  slug String @unique @default(dbgenerated("left(replace((gen_random_uuid())::text, '-'::text, ''::text), 16)"))

  /// Real name — this is what goes on the delivery label.
  name    String
  phone   String
  city    String
  address String
  note    String @default("")

  /// Avatar catalogue id like `royal-f2`, picked on the customer's own page.
  /// The tier prefix is the point: it says what kind of customer this is, so
  /// the picture is readable at a glance and avatarTier() can recover it
  /// without a second column. See lib/avatar.ts for the catalogue.
  /// Null means none was chosen — render the initials monogram instead.
  avatar String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@index([name])
  @@map("customers")
}

model Order {
  id Int @id @default(autoincrement())

  /// `RL-260804TXI` — RL, the Yangon date as YYMMDD, then three random letters.
  /// Supplied by generateOrderCode() rather than a sequence, because the code
  /// carries the order date. The unique index is what actually guarantees
  /// uniqueness; createOrder() retries on collision.
  code String @unique
  slug String @unique @default(dbgenerated("left(replace((gen_random_uuid())::text, '-'::text, ''::text), 16)"))

  /// Nullable: a walk-in can be typed in without a saved customer record.
  /// SetNull rather than Cascade — deleting a customer must not erase the
  /// order history, and the snapshot below keeps the row readable.
  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ── Snapshot, taken at save time. Deliberately not a join. ──
  customerName String @map("customer_name")
  phone        String
  city         String
  address      String @default("")

  /// Whole kyats. Authoritative and immutable — kept even though it could be
  /// recomputed from items, because item prices change over time.
  total         Int
  paymentMethod PaymentMethod  @map("payment_method")
  status        DeliveryStatus @default(pending)
  notifyBySms   Boolean        @default(true) @map("notify_by_sms")
  /// Free-text note staff can leave on the order — special instructions, a
  /// customer request, anything that isn't a delivery status. Editable any
  /// time, unlike the snapshot fields above.
  note          String         @default("")

  placedAt  DateTime @default(now()) @map("placed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Who wrote the order. Null for orders from before tracking, and once that
  /// account is deleted — OrderChange keeps the name either way.
  createdById Int?   @map("created_by_id")
  createdBy   Staff? @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Soft delete: set, the order is gone from every list, count and total, but
  /// the row stays so an admin can restore it. Null means live.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById Int?      @map("deleted_by_id")
  deletedBy   Staff?    @relation("OrderDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  changes      OrderChange[]

  @@index([customerId])
  @@index([deletedAt])
  @@index([status])
  @@index([placedAt(sort: Desc)])
  @@map("orders")
}

/// One product line on an order.
///
/// `name`, `sku` and `unitPrice` are snapshots for the same reason the address
/// is: a price rise next month must not rewrite last month's revenue, and a SKU
/// edited on the catalog page must not silently relabel what was picked off the
/// shelf last month.
model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Null once a product is deleted, or for an ad-hoc line never in the catalog.
  productId Int?     @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name      String
  /// Catalog SKU as it read at time of sale. Empty for a line whose product was
  /// already gone when the order was written, and for the rows that predate this
  /// column — nothing else can be recovered for those.
  sku       String @default("")
  /// Whole kyats, at the time of sale.
  unitPrice Int    @map("unit_price")
  quantity  Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Product {
  id       Int     @id @default(autoincrement())
  sku      String  @unique
  name     String
  /// Current list price, whole kyats. Orders snapshot their own copy.
  price    Int
  /// Units on hand. Live and mutable — unlike price and name it is NOT
  /// snapshotted onto an order, because "how many are left" is only ever a
  /// question about now. Never negative; the check constraint enforces it.
  stock    Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([isActive])
  @@map("products")
}

/// Append-only delivery history. Powers the order timeline, and later answers
/// "how long do orders sit in packing".
model OrderStatusEvent {
  id      Int   @id @default(autoincrement())
  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    DeliveryStatus
  note      String         @default("")
  /// Name of the staff member who made the change. Empty on rows from before
  /// tracking; "system" on the first event of those older orders.
  changedBy String         @default("") @map("changed_by")

  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@index([orderId, changedAt])
  @@map("order_status_events")
}

/// Append-only log of every change to an order: who, when, and what.
///
/// `staffName` is a snapshot, like an order's address: renaming or removing the
/// account must not rewrite who did what. One row per changed field on an edit.
model OrderChange {
  id      Int   @id @default(autoincrement())
  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  staffId   Int?   @map("staff_id")
  staff     Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName String @map("staff_name")

  action   OrderChangeAction
  /// What changed on an `updated` row — `address`, `items`, `total`, …
  field    String            @default("")
  oldValue String            @default("") @map("old_value")
  newValue String            @default("") @map("new_value")

  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@index([orderId, changedAt])
  @@map("order_changes")
}

/// A person who can sign in to the admin app. Replaces the shared
/// ADMIN_USERNAME / ADMIN_PASSWORD pair that used to live in the environment.
///
/// `username` is stored trimmed and lowercased, so the unique index is also the
/// case-insensitive match the login form needs.
/// `passwordHash` is `scrypt$<salt>$<hash>` from lib/password.ts — never the
/// password itself. `active` is how someone is switched off without deleting
/// them: a deactivated person's cookie stops working on its next request.
model Staff {
  id           Int       @id @default(autoincrement())
  /// Real name, for display. Not unique and not used to sign in.
  name         String    @default("")
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         StaffRole @default(staff)
  active       Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ordersCreated Order[]       @relation("OrderCreatedBy")
  ordersDeleted Order[]       @relation("OrderDeletedBy")
  orderChanges  OrderChange[]

  @@map("staff")
}
