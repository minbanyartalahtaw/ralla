// RALLA — order and delivery admin.
//
// Conventions used throughout:
//   * `id` is an internal surrogate key and is never displayed. `code` is the
//     human-facing identifier (RL-10429, RLC-1001) and comes from a Postgres
//     sequence, so two staff saving at once can't mint the same one.
//   * Money is a whole number of kyats. Never a float — see CLAUDE.md.
//   * Orders COPY the customer's details at save time instead of joining live.
//     A customer who moves house or renames their TikTok must not rewrite where
//     past orders were delivered.
//   * Timestamps are `timestamptz`. Myanmar is UTC+06:30, so formatting must
//     happen in Asia/Yangon at render time, never by slicing an ISO string.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Delivery lifecycle. Mirrors DELIVERY_STATUS in lib/orders.ts, which supplies
/// the labels and colors for these values.
enum DeliveryStatus {
  pending
  packing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  paid
  cod
  refunded
}

/// Someone who buys from the TikTok shop.
///
/// `tiktokUsername` is a unique LOOKUP key, not the identity — its owner can
/// rename it at any time. Anything referencing a customer uses `id`. Store it
/// normalized (lowercase, no `@`) via normalizeTiktokUsername().
model Customer {
  id   Int    @id @default(autoincrement())
  code String @unique @default(dbgenerated("('RLC-' || nextval('customer_code_seq'))"))

  tiktokUsername String @unique @map("tiktok_username")
  /// TikTok profile display name. Often nothing like their real name.
  tiktokName     String @default("") @map("tiktok_name")
  /// Real name — this is what goes on the delivery label.
  name           String
  phone          String
  city           String
  address        String
  note           String @default("")

  /// Avatar catalogue id like `royal-f2`, picked on the customer's own page.
  /// The tier prefix is the point: it says what kind of customer this is, so
  /// the picture is readable at a glance and avatarTier() can recover it
  /// without a second column. See lib/avatar.ts for the catalogue.
  /// Null means none was chosen — render the initials monogram instead.
  avatar String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@index([name])
  @@map("customers")
}

model Order {
  id Int @id @default(autoincrement())

  /// `RL-260804TXI` — RL, the Yangon date as YYMMDD, then three random letters.
  /// Supplied by generateOrderCode() rather than a sequence, because the code
  /// carries the order date. The unique index is what actually guarantees
  /// uniqueness; createOrder() retries on collision.
  code String @unique

  /// Nullable: a walk-in can be typed in without a saved customer record.
  /// SetNull rather than Cascade — deleting a customer must not erase the
  /// order history, and the snapshot below keeps the row readable.
  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ── Snapshot, taken at save time. Deliberately not a join. ──
  customerName String @map("customer_name")
  phone        String
  city         String
  address      String @default("")

  /// Whole kyats. Authoritative and immutable — kept even though it could be
  /// recomputed from items, because item prices change over time.
  total         Int
  paymentMethod PaymentMethod  @map("payment_method")
  status        DeliveryStatus @default(pending)
  notifyBySms   Boolean        @default(true) @map("notify_by_sms")
  /// Free-text note staff can leave on the order — special instructions, a
  /// customer request, anything that isn't a delivery status. Editable any
  /// time, unlike the snapshot fields above.
  note          String         @default("")

  placedAt  DateTime @default(now()) @map("placed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items        OrderItem[]
  statusEvents OrderStatusEvent[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt(sort: Desc)])
  @@map("orders")
}

/// One product line on an order.
///
/// `name` and `unitPrice` are snapshots for the same reason the address is: a
/// price rise next month must not rewrite last month's revenue.
model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Null once a product is deleted, or for an ad-hoc line never in the catalog.
  productId Int?     @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name      String
  /// Whole kyats, at the time of sale.
  unitPrice Int    @map("unit_price")
  quantity  Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Product {
  id       Int     @id @default(autoincrement())
  sku      String  @unique
  name     String
  /// Current list price, whole kyats. Orders snapshot their own copy.
  price    Int
  /// Units on hand. Live and mutable — unlike price and name it is NOT
  /// snapshotted onto an order, because "how many are left" is only ever a
  /// question about now. Never negative; the check constraint enforces it.
  stock    Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([isActive])
  @@map("products")
}

/// Append-only delivery history. Powers the order timeline, and later answers
/// "how long do orders sit in packing".
model OrderStatusEvent {
  id      Int   @id @default(autoincrement())
  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    DeliveryStatus
  note      String         @default("")
  /// Admin who made the change. Free text until auth exists.
  changedBy String         @default("") @map("changed_by")

  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@index([orderId, changedAt])
  @@map("order_status_events")
}
